@page "/"
@inject EquipmentApiService ApiService
@inject IStringLocalizer<App> Localizer

<PageTitle>@Localizer["AppName"]</PageTitle>

<h1>@Localizer["Equipment"]</h1>

@if (equipments is null)
{
    <p class="text-muted">@Localizer["Loading"]</p>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>@Localizer["Name"]</th>
                <th>@Localizer["Category"]</th>
                <th>@Localizer["Status"]</th>
                <th>@Localizer["Borrower"]</th>
                <th>@Localizer["BorrowDate"]</th>
                <th>@Localizer["LastReturn"]</th>
                <th class="text-end">@Localizer["Action"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var equipment in equipments)
            {
                <tr>
                    <td>@equipment.Name</td>
                    <td>@equipment.Category</td>
                    <td>
                        @if (equipment.IsAvailable)
                        {
                            <span class="badge text-bg-success">@Localizer["Available"]</span>
                        }
                        else
                        {
                            <span class="badge text-bg-warning">@Localizer["Borrowed"]</span>
                        }
                    </td>
                    <td>
                        @if (equipment.IsAvailable)
                        {
                            @("-")
                        }
                        else
                        {
                            @($"{equipment.BorrowerFirstName} {equipment.BorrowerLastName}")
                        }
                    </td>
                    <td>@(equipment.BorrowDate?.ToString("g") ?? "-")</td>
                    <td>@(equipment.LastReturnDate?.ToString("g") ?? "-")</td>
                    <td class="text-end">
                        @if (equipment.IsAvailable)
                        {
                            <button class="btn btn-sm btn-primary" @onclick="() => ShowBorrowForm(equipment.Id)" disabled="@isBusy">
                                @Localizer["Borrow"]
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => ReturnAsync(equipment)" disabled="@isBusy">
                                @Localizer["Return"]
                            </button>
                        }
                    </td>
                </tr>
                @if (borrowingEquipmentId == equipment.Id)
                {
                    <tr>
                        <td colspan="7">
                            <form @onsubmit="BorrowAsync" @onsubmit:preventDefault="true" class="d-flex gap-2 align-items-center flex-wrap">
                                <label for="borrowFirstName">Prénom</label>
                                <input id="borrowFirstName" class="form-control w-auto" @bind="firstName" required disabled="@isBusy" />
                                <label for="borrowLastName">Nom</label>
                                <input id="borrowLastName" class="form-control w-auto" @bind="lastName" required disabled="@isBusy" />
                                <button type="submit" class="btn btn-primary" disabled="@isBusy">Confirmer</button>
                                <button type="button" class="btn btn-secondary" @onclick="CancelBorrow" disabled="@isBusy">Annuler</button>
                            </form>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
}

@if (errorMessage is not null)
{
    <div class="alert alert-danger" role="alert">
        @errorMessage
        <button class="btn btn-sm btn-outline-danger ms-2" @onclick="LoadEquipmentAsync" disabled="@isBusy">Réessayer</button>
    </div>
}

@code {
    private List<Equipment>? equipments;
    private bool isBusy;
    private string? errorMessage;
    private int? borrowingEquipmentId;
    private string firstName = string.Empty;
    private string lastName = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadEquipmentAsync();
    }

    private async Task LoadEquipmentAsync()
    {
        errorMessage = null;
        try
        {
            equipments = await ApiService.GetEquipmentAsync();
        }
        catch (System.Text.Json.JsonException)
        {
            equipments = new List<Equipment>();
            errorMessage = "La réponse du serveur est invalide. Réessayez après avoir redémarré le serveur.";
        }
        catch (HttpRequestException)
        {
            equipments = new List<Equipment>();
            errorMessage = "Impossible de charger les équipements. Vérifiez que le serveur est démarré, puis réessayez.";
        }
    }

    private void ShowBorrowForm(int id)
    {
        borrowingEquipmentId = id;
        firstName = string.Empty;
        lastName = string.Empty;
    }

    private void CancelBorrow() => borrowingEquipmentId = null;

    private async Task BorrowAsync()
    {
        if (borrowingEquipmentId is not int id) return;
        if (string.IsNullOrWhiteSpace(firstName) || string.IsNullOrWhiteSpace(lastName))
        {
            errorMessage = "Saisissez le prénom et le nom de l’emprunteur.";
            return;
        }
        await ExecuteActionAsync(async () =>
        {
            await ApiService.BorrowAsync(id, firstName.Trim(), lastName.Trim());
            borrowingEquipmentId = null;
        });
    }

    private async Task ReturnAsync(Equipment equipment)
    {
        await ExecuteActionAsync(() => ApiService.ReturnAsync(equipment.Id));
    }

    private async Task ExecuteActionAsync(Func<Task> action)
    {
        isBusy = true;
        errorMessage = null;
        try
        {
            await action();
            await LoadEquipmentAsync();
        }
        catch (HttpRequestException ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }
}
